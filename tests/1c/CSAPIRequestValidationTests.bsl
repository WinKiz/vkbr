// Тестовый общий модуль. Не включать в рабочую поставку.
Функция ВыполнитьВсе() Экспорт
    Счетчик = 0;
    Результат = Проверить("2026-09-01", "2026-09-07");
    Утвердить(Результат.Успех, "AC01: корректный период");
    Утвердить(Результат.Параметры.НачалоПериода = Дата(2026, 9, 1), "AC01: начало");
    Утвердить(Результат.Параметры.КонецПериодаИсключая = Дата(2026, 9, 8), "AC01: конец");
    Счетчик = Счетчик + 1;

    Результат = Проверить("2026-12-31", "2026-12-31");
    Утвердить(Результат.Успех, "AC02: один день");
    Утвердить(Результат.Параметры.КонецПериодаИсключая = Дата(2027, 1, 1), "AC02: смена года");
    Счетчик = Счетчик + 1;
    Результат = Проверить("2028-02-29", "2028-02-29");
    Утвердить(Результат.Успех, "AC03: високосная дата");
    Утвердить(Результат.Параметры.КонецПериодаИсключая = Дата(2028, 3, 1), "AC02: смена месяца");
    Счетчик = Счетчик + 1;

    Для Каждого ДатаТекст Из СтрРазделить("2026-02-29,2026-02-30,2026-13-01,2026-00-01,0000-01-01,2026-9-01,2026/09/01, 2026-09-01,2026-09-01 ,２０２６-09-01", ",") Цикл
        ПроверитьОтказ(Проверить(ДатаТекст, "2028-03-01"), "DATE_START_INVALID");
        Счетчик = Счетчик + 1;
    КонецЦикла;
    ПроверитьОтказ(Проверить("2026-09-02", "2026-09-01"), "PERIOD_REVERSED");
    Счетчик = Счетчик + 1;
    ПроверитьОтказ(Проверить("2026-09-01", "2026-02-30"), "DATE_END_INVALID");
    Счетчик = Счетчик + 1;

    Параметры = БазовыеПараметры();
    Параметры.Удалить("dateStart");
    ПроверитьОтказ(CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры), "DATE_START_INVALID");
    Счетчик = Счетчик + 1;
    Параметры = БазовыеПараметры();
    Параметры.Вставить("dateStart", "");
    ПроверитьОтказ(CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры), "DATE_START_INVALID");
    Счетчик = Счетчик + 1;
    Параметры.Вставить("dateStart", 20260901);
    ПроверитьОтказ(CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры), "DATE_START_INVALID");
    Счетчик = Счетчик + 1;
    ПроверитьОтказ(CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Новый Структура), "INVALID_PARAMETERS_TYPE");
    Счетчик = Счетчик + 1;
    Параметры = БазовыеПараметры();
    Параметры.Вставить("dateStrat", "2026-09-01");
    ПроверитьОтказ(CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры), "UNKNOWN_PARAMETER");
    Счетчик = Счетчик + 1;

    Параметры = БазовыеПараметры();
    Для Каждого Имя Из СтрРазделить("group,teacher,auditory", ",") Цикл
        Параметры.Вставить(Имя, "ABCDEFAB-1234-5678-9ABC-ABCDEFABCDEF");
        Результат = CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры);
        Утвердить(Результат.Успех, "AC05: комбинация фильтров");
        Утвердить(Результат.Параметры[Имя] = "abcdefab-1234-5678-9abc-abcdefabcdef", "AC05: нормализация UUID");
        Счетчик = Счетчик + 1;
    КонецЦикла;
    Для Каждого UUIDТекст Из СтрРазделить("bad,abcdefab123456789abcabcdefabcdef,ABCDEFAB-1234-5678-9ABC-ABCDEFABCDEZ", ",") Цикл
        Параметры.Вставить("group", UUIDТекст);
        ПроверитьОтказ(CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры), "FILTER_INVALID");
        Счетчик = Счетчик + 1;
    КонецЦикла;
    Параметры.Вставить("group", "");
    ПроверитьОтказ(CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры), "FILTER_INVALID");
    Счетчик = Счетчик + 1;
    Параметры.Вставить("group", Неопределено);
    ПроверитьОтказ(CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры), "FILTER_INVALID");
    Счетчик = Счетчик + 1;
    Параметры.Вставить("group", "00000000-0000-0000-0000-000000000000");
    Утвердить(CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры).Успех, "AC05: UUID без поиска объекта");
    Счетчик = Счетчик + 1;

    Параметры = БазовыеПараметры();
    Результат = CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры, 7);
    Утвердить(Результат.Успех, "AC06: ровно семь дней");
    Счетчик = Счетчик + 1;
    Параметры.Вставить("dateEnd", "2026-09-08");
    ПроверитьОтказ(CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры, 7), "PERIOD_LIMIT_EXCEEDED");
    Счетчик = Счетчик + 1;
    ПойманоИсключение = Ложь;
    Попытка
        CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры, 0);
    Исключение
        ПойманоИсключение = Истина;
    КонецПопытки;
    Утвердить(ПойманоИсключение, "AC06: неверная настройка сервера");
    Счетчик = Счетчик + 1;
    Параметры = БазовыеПараметры();
    Результат = CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры);
    Утвердить(Параметры.Количество() = 2 И Параметры.Получить("dateStart") = "2026-09-01", "AC07: вход не изменен");
    Утвердить(Результат.Параметры.group = Неопределено, "AC05: отсутствующий фильтр");
    Счетчик = Счетчик + 1;
    Возврат Новый Структура("Успех,КоличествоСценариев", Истина, Счетчик);
КонецФункции

Функция БазовыеПараметры()
    Параметры = Новый Соответствие;
    Параметры.Вставить("dateStart", "2026-09-01");
    Параметры.Вставить("dateEnd", "2026-09-07");
    Возврат Параметры;
КонецФункции

Функция Проверить(Начало, Конец)
    Параметры = Новый Соответствие;
    Параметры.Вставить("dateStart", Начало);
    Параметры.Вставить("dateEnd", Конец);
    Возврат CSAPIRequestValidation.ПроверитьПараметрыЗапроса(Параметры);
КонецФункции

Процедура ПроверитьОтказ(Результат, ОжидаемыйКод)
    Утвердить(Не Результат.Успех, "Ожидался отказ: " + ОжидаемыйКод);
    Утвердить(Результат.КодОшибки = ОжидаемыйКод, "Неверный код ошибки: " + ОжидаемыйКод);
    Утвердить(Результат.Параметры = Неопределено, "Ошибка не должна возвращать частичные параметры");
КонецПроцедуры

Процедура Утвердить(Условие, Текст)
    Если Не Условие Тогда
        ВызватьИсключение Текст;
    КонецЕсли;
КонецПроцедуры
