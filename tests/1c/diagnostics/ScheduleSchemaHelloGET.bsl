// Временный модуль HTTP-сервиса TestService для локальной диагностики.
// Не читает записи регистра. Не включать в рабочую поставку.
// Перед заменой сохранить исходный модуль; после проверки восстановить его.

Функция HelloGET(Запрос)

    МетаданныеРасписания = Метаданные.РегистрыСведений.Найти("Расписание");
    Если МетаданныеРасписания = Неопределено Тогда
        Данные = Новый Структура("status,code", "error", "SCHEDULE_REGISTER_NOT_FOUND");
        Возврат ОтветДиагностикиJSON(500, Данные);
    КонецЕсли;

    Поля = Новый Массив;
    ДобавитьПоляДиагностики(Поля, МетаданныеРасписания.Измерения, "dimension");
    ДобавитьПоляДиагностики(Поля, МетаданныеРасписания.Ресурсы, "resource");
    ДобавитьПоляДиагностики(Поля, МетаданныеРасписания.Реквизиты, "attribute");

    Данные = Новый Структура;
    Данные.Вставить("status", "ok");
    Данные.Вставить("mode", "schema_only");
    Данные.Вставить("register", МетаданныеРасписания.Имя);
    Данные.Вставить("fields", Поля);
    Возврат ОтветДиагностикиJSON(200, Данные);

КонецФункции

Процедура ДобавитьПоляДиагностики(Поля, КоллекцияМетаданных, ВидПоля)

    Для Каждого ПолеМетаданных Из КоллекцияМетаданных Цикл
        ОписаниеПоля = Новый Структура;
        ОписаниеПоля.Вставить("kind", ВидПоля);
        ОписаниеПоля.Вставить("name", ПолеМетаданных.Имя);
        ОписаниеПоля.Вставить("type", Строка(ПолеМетаданных.Тип));
        Поля.Добавить(ОписаниеПоля);
    КонецЦикла;

КонецПроцедуры

Функция ОтветДиагностикиJSON(КодСостояния, Данные)

    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Данные);
    Тело = Запись.Закрыть();

    Ответ = Новый HTTPСервисОтвет(КодСостояния);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
    Возврат Ответ;

КонецФункции
