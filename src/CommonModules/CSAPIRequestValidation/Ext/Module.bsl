#Область ПрограммныйИнтерфейс

// Контракт: specs/001-request-validation/spec.md.
// Параметры — Соответствие строковых ключей и значений. Доступа к базе нет.
Функция ПроверитьПараметрыЗапроса(Параметры, МаксимумДней = Неопределено) Экспорт

    Если МаксимумДней <> Неопределено Тогда
        Если ТипЗнч(МаксимумДней) <> Тип("Число") Тогда
            ВызватьИсключение "МаксимумДней должен быть положительным целым числом.";
        КонецЕсли;
        Если МаксимумДней <= 0 Или Цел(МаксимумДней) <> МаксимумДней Тогда
            ВызватьИсключение "МаксимумДней должен быть положительным целым числом.";
        КонецЕсли;
    КонецЕсли;

    Если ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
        Возврат Отказ("INVALID_PARAMETERS_TYPE", "Ожидается соответствие параметров запроса.");
    КонецЕсли;

    ДопустимыеИмена = Новый Соответствие;
    Для Каждого Имя Из СтрРазделить("dateStart,dateEnd,group,teacher,auditory", ",") Цикл
        ДопустимыеИмена.Вставить(Имя, Истина);
    КонецЦикла;
    ПереданныеИмена = Новый Соответствие;
    Для Каждого Параметр Из Параметры Цикл
        Если ДопустимыеИмена.Получить(Параметр.Ключ) = Неопределено Тогда
            Возврат Отказ("UNKNOWN_PARAMETER", "Обнаружен неподдерживаемый параметр.");
        КонецЕсли;
        ПереданныеИмена.Вставить(Параметр.Ключ, Истина);
    КонецЦикла;

    НачалоПериода = ПрочитатьДатуISO(Параметры.Получить("dateStart"));
    Если НачалоПериода = Неопределено Тогда
        Возврат Отказ("DATE_START_INVALID", "dateStart должен содержать существующую дату YYYY-MM-DD.");
    КонецЕсли;
    ПоследнийДень = ПрочитатьДатуISO(Параметры.Получить("dateEnd"));
    Если ПоследнийДень = Неопределено Тогда
        Возврат Отказ("DATE_END_INVALID", "dateEnd должен содержать существующую дату YYYY-MM-DD.");
    КонецЕсли;
    Если НачалоПериода > ПоследнийДень Тогда
        Возврат Отказ("PERIOD_REVERSED", "dateStart не может быть позже dateEnd.");
    КонецЕсли;

    Попытка
        КонецПериодаИсключая = ПоследнийДень + 86400;
    Исключение
        Возврат Отказ("DATE_END_BOUNDARY", "Невозможно представить день после dateEnd.");
    КонецПопытки;
    Если МаксимумДней <> Неопределено Тогда
        ЧислоДней = (ПоследнийДень - НачалоПериода) / 86400 + 1;
        Если ЧислоДней > МаксимумДней Тогда
            Возврат Отказ("PERIOD_LIMIT_EXCEEDED", "Период превышает установленный предел.");
        КонецЕсли;
    КонецЕсли;

    Нормализованные = Новый Структура;
    Нормализованные.Вставить("НачалоПериода", НачалоПериода);
    Нормализованные.Вставить("КонецПериодаИсключая", КонецПериодаИсключая);
    Для Каждого Имя Из СтрРазделить("group,teacher,auditory", ",") Цикл
        ЗначениеФильтра = Неопределено;
        Если ПереданныеИмена.Получить(Имя) = Истина Тогда
            ЗначениеФильтра = ПрочитатьUUID(Параметры.Получить(Имя));
            Если ЗначениеФильтра = Неопределено Тогда
                Возврат Отказ("FILTER_INVALID", "Фильтр должен содержать UUID в формате 8-4-4-4-12.");
            КонецЕсли;
        КонецЕсли;
        Нормализованные.Вставить(Имя, ЗначениеФильтра);
    КонецЦикла;

    Возврат Новый Структура("Успех,КодОшибки,Сообщение,Параметры",
        Истина, "", "", Нормализованные);

КонецФункции

#КонецОбласти

#Область СлужебныеФункции

Функция Отказ(Код, Сообщение)
    Возврат Новый Структура("Успех,КодОшибки,Сообщение,Параметры",
        Ложь, Код, Сообщение, Неопределено);
КонецФункции

Функция ПрочитатьДатуISO(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если СтрДлина(Значение) <> 10 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если Сред(Значение, 5, 1) <> "-" Или Сред(Значение, 8, 1) <> "-" Тогда
        Возврат Неопределено;
    КонецЕсли;
    Для Позиция = 1 По 10 Цикл
        Если Позиция = 5 Или Позиция = 8 Тогда
            Продолжить;
        КонецЕсли;
        Если СтрНайти("0123456789", Сред(Значение, Позиция, 1)) = 0 Тогда
            Возврат Неопределено;
        КонецЕсли;
    КонецЦикла;
    Попытка
        ГодДаты = Число(Лев(Значение, 4));
        МесяцДаты = Число(Сред(Значение, 6, 2));
        ДеньДаты = Число(Прав(Значение, 2));
        Результат = Дата(ГодДаты, МесяцДаты, ДеньДаты);
        Если Год(Результат) <> ГодДаты Или Месяц(Результат) <> МесяцДаты Или День(Результат) <> ДеньДаты Тогда
            Возврат Неопределено;
        КонецЕсли;
        Возврат Результат;
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

Функция ПрочитатьUUID(Значение)
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        Возврат Неопределено;
    КонецЕсли;
    Если СтрДлина(Значение) <> 36 Тогда
        Возврат Неопределено;
    КонецЕсли;
    Для Позиция = 1 По 36 Цикл
        Символ = Сред(Значение, Позиция, 1);
        Если Позиция = 9 Или Позиция = 14 Или Позиция = 19 Или Позиция = 24 Тогда
            Если Символ <> "-" Тогда
                Возврат Неопределено;
            КонецЕсли;
        ИначеЕсли СтрНайти("0123456789abcdefABCDEF", Символ) = 0 Тогда
            Возврат Неопределено;
        КонецЕсли;
    КонецЦикла;
    Попытка
        Идентификатор = Новый УникальныйИдентификатор(Значение);
        Возврат НРег(Строка(Идентификатор));
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

#КонецОбласти
